module Registry
  ## The registry's HTTP protocol as a Rack-style handler.
  class API
    # `blob_redirect` is a proxy's internal location for blob files, such as "/_blobs/". With it,
    # the proxy sends the bytes and this service only decides whether they may be served.
    ## Serves under the `base` path prefix. A non-empty `blob_redirect` (such as
    ## `"/_blobs/"`) answers blob downloads with `X-Accel-Redirect` instead of the bytes.
    def initialize(db, store, publisher, base: String = "", blob_redirect: String = "")
      @db = db
      @store = store
      @publisher = publisher
      @base = base
      @blob_redirect = blob_redirect
      @records = Records.new(db)
      @administration = Administration.new(db)
    end

    def failure_status(failure: Failure) -> Int
      case failure
      when Unauthorized then 401
      when Forbidden then 403
      when NotFound then 404
      when InvalidRequest then 400
      when InvalidArchive then 422
      when PayloadTooLarge then 413
      when ReleaseExists then 409
      when IdempotencyConflict then 409
      when LastOwner then 409
      end
    end

    def json(status, body)
      [status, {"Content-Type": "application/json", "Cache-Control": "no-store"}, JSON.stringify(body)]
    end

    def error(status, code)
      response = self.json(status, {"protocol": 1, "error": code, "message": code, "request_id": SecureRandom.hex(16)})
      if status == 401 then response[1]["WWW-Authenticate"] = "Bearer" end
      response
    end

    # The d6 version a facet sent as `?d6=`, or nil when the query has none.
    def client_d6(query: String) -> String | Nil
      return nil if query == ""
      values = query.split("=")
      unless values.length() == 2 && values[0] == "d6" && SemVer.valid?(values[1])
        raise InvalidRequest.new()
      end
      values[1]
    end

    # Only the versions the asking facet's d6 can install, so the newest of them wins.
    def index(name, client: String | Nil = nil)
      cut = @records.cut(name)
      if cut == nil then return self.error(404, "not_found") end
      served = @records.served_releases(cut.id()).select() do |release| release.usable_by?(client) end
      releases = served.sort() do |a, b| SemVer.compare(a.version(), b.version()) end
      versions = releases.map() do |release| {"version": release.version(), "yanked": release.yanked?()} end
      self.json(200, {"protocol": 1, "versions": versions})
    end

    def release(name, version, client: String | Nil = nil)
      found = @records.served_release(name, version)
      if found == nil || !found.usable_by?(client) then return self.error(404, "not_found") end
      body = {"protocol": 1, "name": name, "version": version, "dependencies": JSON.parse(found.dependencies()), "yanked": found.yanked?(),
        "archive": {"path": "/v1/blobs/sha256/#{found.sha256()}", "sha256": found.sha256(), "size": found.size()}}
      range = found.d6()
      if range != nil then body["d6"] = range end
      self.json(200, body)
    end

    def details(release_id: Int) -> Hash = @records.details(release_id)

    def blob(digest)
      BlobStore.validate_digest(digest)
      found = @records.served_blob(digest)
      if found == nil then return self.error(404, "not_found") end
      headers = {"Content-Type": "application/octet-stream", "Cache-Control": "no-store"}
      if @blob_redirect != ""
        # The proxy doesn't hash what it sends: applications/registry/scrub.d6 covers that, and facet checks the digest.
        if File.size(@store.path(digest)) != found.size() then raise IOError.new("blob size mismatch") end
        headers["X-Accel-Redirect"] = @blob_redirect + digest
        return [200, headers, ""]
      end
      bytes = @store.read(digest)
      if bytes.bytesize() != found.size() then raise IOError.new("blob size mismatch") end
      [200, headers, bytes]
    end

    def upload(name, request)
      headers = request["headers"]
      authorization = headers["authorization"]
      if authorization == nil || !authorization.start_with?("Bearer ") then return self.error(401, "unauthorized") end
      if headers["content-type"] != "application/octet-stream" then return self.error(400, "invalid_request") end
      key = headers["idempotency-key"]
      if key == nil then key = "" end
      result = @publisher.publish(name, request["body"], authorization.slice(7, authorization.length() - 7), key)
      status = if result["created"] then 201 else 200 end
      self.json(status, {"protocol": 1, "name": result["name"], "version": result["version"], "sha256": result["sha256"], "size": result["size"], "yanked": result["yanked"]})
    end

    def manage(name, version, action, request)
      authorization = request["headers"]["authorization"]
      if authorization == nil || !authorization.start_with?("Bearer ") then return self.error(401, "unauthorized") end
      if request["headers"]["content-type"] != "application/json" || request["body"].length() > 4096
        return self.error(400, "invalid_request")
      end
      begin
        payload = JSON.parse(request["body"])
      rescue error: StandardError
        return self.error(400, "invalid_request")
      end
      unless payload is Hash then return self.error(400, "invalid_request") end
      unless payload["reason"] is String then return self.error(400, "invalid_request") end
      if payload.length() != 1 then return self.error(400, "invalid_request") end
      result = @administration.change(name, version, action, payload["reason"], authorization.slice(7, authorization.length() - 7))
      if action == "takedown" then return self.json(200, result) end
      self.release(name, version)
    end

    def bearer(request)
      authorization = request["headers"]["authorization"]
      if authorization == nil || !authorization.start_with?("Bearer ") then raise Unauthorized.new() end
      authorization.slice(7, authorization.length() - 7)
    end

    def owner_request(name, action, request)
      token = self.bearer(request)
      if action == "list" then return self.json(200, @administration.owners(name, token)) end
      if request["headers"]["content-type"] != "application/json" || request["body"].length() > 4096 then raise InvalidRequest.new() end
      begin
        payload = JSON.parse(request["body"])
      rescue error: StandardError
        raise InvalidRequest.new()
      end
      unless payload is Hash then raise InvalidRequest.new() end
      unless payload["owner"] is String then raise InvalidRequest.new() end
      unless payload["reason"] is String then raise InvalidRequest.new() end
      if payload.length() != 2 then raise InvalidRequest.new() end
      self.json(200, @administration.change_owner(name, payload["owner"], action, payload["reason"], token))
    end

    def audit_request(path, request)
      token = self.bearer(request)
      parameters = {"after": 0, "limit": 50}
      parts = path.split("?")
      if parts.length() > 2 then raise InvalidRequest.new() end
      if parts.length() == 2
        seen = []
        parts[1].split("&").each() do |pair|
          values = pair.split("=")
          if values.length() != 2 then raise InvalidRequest.new() end
          key = values[0]
          if !["after", "limit"].include?(key) || seen.include?(key) then raise InvalidRequest.new() end
          seen.push(key)
          value = values[1].to_i()
          if "#{value}" != values[1] || value > 9223372036854775807 then raise InvalidRequest.new() end
          parameters[key] = value
        end
      end
      self.json(200, @administration.audit(token, parameters["after"], parameters["limit"]))
    end

    ## Handles one request (header names lower-cased) and returns
    ## `[status, headers, body]`: version indexes, release metadata, blobs, publishing,
    ## yank/unyank/takedown, owners and the audit log.
    def call(request)
      begin
        path = request["path"]
        if @base != ""
          unless path.start_with?("#{@base}/") then return self.error(404, "not_found") end
          path = path.slice(@base.length(), path.length() - @base.length())
        end
        method = request["method"]
        if path == "/health" && method == "GET"
          @db.query("SELECT 1")
          return self.json(200, {"protocol": 1, "status": "ok"})
        end
        if method == "GET" && (path == "/v1/audit" || path.start_with?("/v1/audit?"))
          return self.audit_request(path, request)
        end
        # Only the version index and release documents take a query (`?d6=`).
        pieces = path.split("?")
        if pieces.length() > 2 then raise InvalidRequest.new() end
        query = pieces.length() == 2 ? pieces[1] : ""
        parts = pieces[0].split("/")
        takes_query = method == "GET" && parts.length() >= 5 && parts.length() <= 6 && parts[2] == "cuts" && parts[4] == "versions"
        if query != "" && !takes_query then return self.error(404, "not_found") end
        if parts.length() >= 5 && parts[1] == "v1" && parts[2] == "cuts" && parts[4] == "owners"
          if parts.length() == 5 && method == "GET" then return self.owner_request(parts[3], "list", request) end
          if parts.length() == 6 && method == "POST" && ["add", "remove"].include?(parts[5])
            return self.owner_request(parts[3], parts[5], request)
          end
        end
        if parts.length() == 5 && parts[1] == "v1" && parts[2] == "blobs" && parts[3] == "sha256" && method == "GET"
          return self.blob(parts[4])
        end
        if parts.length() >= 5 && parts[1] == "v1" && parts[2] == "cuts" && parts[4] == "versions"
          if parts.length() == 5
            if method == "GET" then return self.index(parts[3], self.client_d6(query)) end
            if method == "POST" then return self.upload(parts[3], request) end
          elsif parts.length() == 7 && method == "POST" && ["yank", "unyank", "takedown"].include?(parts[6])
            return self.manage(parts[3], parts[5], parts[6], request)
          elsif parts.length() == 6 && method == "GET"
            return self.release(parts[3], parts[5], self.client_d6(query))
          end
        end
        self.error(404, "not_found")
      rescue error: Failure
        self.error(self.failure_status(error), error.message())
      rescue error: ArgumentError
        self.error(400, "invalid_request")
      rescue error: StandardError
        self.error(500, "internal_error")
      end
    end
  end
end

