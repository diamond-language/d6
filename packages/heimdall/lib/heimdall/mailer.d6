module Heimdall
  # A mail outbox. A request never sends mail itself: it writes a row to
  # mail_outbox(id, to_address, subject, body, attempts, next_attempt_at,
  # created_at), and a worker tick calls deliver_due. Each message is
  # claimed with a compare-and-set, so one worker sends it; a failure retries
  # with a growing pause, then the message is dropped. A slow or broken mail
  # service can't hold up a request.
  #
  # `sender` is called with the row and returns true once the message is
  # handed off. Mailer.log_sender, Mailer.directory_sender and
  # Mailer.command_sender cover the usual cases. A nil sender switches mail
  # off: enqueue returns false and queues nothing.
  class Mailer
    def initialize(store, sender, logger = nil, table = "mail_outbox", max_attempts = 5)
      @store = store
      @sender = sender
      @logger = logger
      @max_attempts = max_attempts
      @schema = store.schema(table, {"to_address": :string, "subject": :string, "body": :string,
        "attempts": :int, "next_attempt_at": :int, "created_at": :int})
    end

    def schema() = @schema
    def enabled?() = @sender != nil

    # Queues a message. False, with nothing queued, when mail is off.
    def enqueue(to, subject, body)
      if @sender == nil then return false end
      now = Heimdall.now()
      @store.insert(@schema, {"to_address": to, "subject": subject, "body": body,
        "attempts": 0, "next_attempt_at": now, "created_at": now})
      true
    end

    # Delivers up to 20 due messages. Returns how many were sent.
    def deliver_due(now = nil)
      if @sender == nil then return 0 end
      at = if now == nil then Heimdall.now() else now end
      repo = @store.repo()
      sent = 0
      due = repo.all(@schema.query().where(@schema.column("next_attempt_at").lteq(at)).order_by("created_at").limit(20))
      due.each() do |row|
        attempts = row["attempts"] + 1
        claim = @schema.query().where({"id": row["id"], "next_attempt_at": row["next_attempt_at"]})
        if repo.update_all(claim, {"attempts": attempts, "next_attempt_at": at + 60 * attempts * attempts}) == 1
          delivered = false
          begin
            delivered = @sender.call(row) == true
          rescue error: StandardError
            self.log("warn", "mail.failed", {"id": row["id"], "error": error.message()})
          end
          if delivered
            repo.delete(@schema, row["id"])
            sent += 1
            self.log("info", "mail.sent", {"id": row["id"], "attempts": attempts})
          elsif attempts >= @max_attempts
            repo.delete(@schema, row["id"])
            self.log("error", "mail.dropped", {"id": row["id"], "attempts": attempts})
          else
            self.log("warn", "mail.retry", {"id": row["id"], "attempts": attempts})
          end
        end
      end
      sent
    end

    def log(level, event, fields)
      if @logger == nil then return nil end
      case level
      when "info" then @logger.info(event, fields)
      when "warn" then @logger.warn(event, fields)
      else @logger.error(event, fields)
      end
    end

    # The message as RFC 5322 text, for a sendmail-style command.
    def self.message_text(row, from)
      "From: #{from}\r\nTo: #{row["to_address"]}\r\nSubject: #{row["subject"]}\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n#{row["body"]}\r\n"
    end

    # Logs each message instead of sending it (development).
    def self.log_sender(logger)
      def send_to_log(row)
        logger.info("mail.logged", {"to": row["to_address"], "subject": row["subject"], "body": row["body"]})
        true
      end
      send_to_log
    end

    # Writes each message to `dir` as JSON (tests and local inspection).
    def self.directory_sender(dir)
      def send_to_directory(row)
        if !File.directory?(dir) then Dir.mkdir(dir) end
        message = {"to": row["to_address"], "subject": row["subject"], "body": row["body"]}
        File.write("#{dir}/#{row["id"]}-#{SecureRandom.hex(4)}.json", JSON.stringify(message))
        true
      end
      send_to_directory
    end

    # Pipes each message to a sendmail-style command, killed after 30 seconds.
    def self.command_sender(command, from)
      def send_to_command(row)
        result = Process.run(["sh", "-c", "timeout 30 " + command], {"stdin": Mailer.message_text(row, from)})
        result.success?()
      end
      send_to_command
    end
  end
end
