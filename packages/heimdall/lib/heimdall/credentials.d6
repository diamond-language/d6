module Heimdall
  # Email and password rules, and bcrypt.
  module Credentials
    # A real bcrypt digest of a throwaway value. Checking a password against
    # it when no account matched keeps sign-in timing the same for known and
    # unknown emails.
    def self.dummy_digest() = "$2b$12$sCm2ciqq5cfNls1GTYOiJO.j1AIdCd.2O9sX8EtdqpWhbqQ6hxFXW"

    def self.cost() = 12

    def self.normalize_email(value) = if value == nil then "" else value.strip().downcase() end

    # Why an email address can't be used, or nil.
    def self.email_problem(email)
      normalized = Credentials.normalize_email(email)
      if normalized.bytesize() > 254 then return "email address is too long" end
      pattern = Regexp.new("^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9-]+(\\.[a-z0-9-]+)+$")
      if !pattern.match?(normalized) then return "enter a valid email address" end
      nil
    end

    # Why a password can't be used, or nil. bcrypt reads only the first 72
    # bytes, so a longer password would be silently cut short.
    def self.password_problem(password, minimum = 8)
      if password == nil || password.length() < minimum then return "password is too short (minimum #{minimum})" end
      if password.bytesize() > 72 then return "password is too long (maximum 72 bytes)" end
      if password.include?("\0") then return "password cannot contain a NUL character" end
      nil
    end

    def self.hash(password) = BCrypt.hash(password, Credentials.cost())

    # True when `password` matches `digest`. A nil digest (no such account)
    # still costs one bcrypt check and answers false.
    def self.verify(password, digest)
      candidate = if password == nil then "" else password end
      usable = candidate.bytesize() <= 72 && !candidate.include?("\0")
      checked = if usable then candidate else "" end
      matched = BCrypt.verify(checked, if digest == nil then Credentials.dummy_digest() else digest end)
      matched && usable && digest != nil
    end
  end
end
