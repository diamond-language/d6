module Heimdall
  # CREATE TABLE statements for Heimdall's tables, for an app's migrations.
  # `dialect` is "sqlite" or "postgres". `id_type` matches the Store's.
  # `session_tables` maps each sessions table to the accounts table it
  # points at, such as {"user_sessions": "users"}.
  module Migrations
    def self.id_column(dialect, id_type)
      if id_type == :string then "id VARCHAR(32) PRIMARY KEY"
      elsif dialect == "postgres" then "id BIGSERIAL PRIMARY KEY"
      else "id INTEGER PRIMARY KEY" end
    end

    def self.reference(dialect, id_type) = if id_type == :string then "VARCHAR(32)" elsif dialect == "postgres" then "BIGINT" else "INTEGER" end

    def self.statements(dialect, id_type, session_tables)
      if dialect != "sqlite" && dialect != "postgres" then raise ArgumentError.new("dialect must be sqlite or postgres") end
      id = Migrations.id_column(dialect, id_type)
      ref = Migrations.reference(dialect, id_type)
      statements = []
      session_tables.keys().each() do |table|
        accounts = session_tables[table]
        statements.push("CREATE TABLE #{table} (#{id}, owner_id #{ref} NOT NULL REFERENCES #{accounts}(id) ON DELETE CASCADE, " +
          "token_digest VARCHAR(64) NOT NULL UNIQUE, expires_at BIGINT NOT NULL, created_at BIGINT NOT NULL)")
        statements.push("CREATE INDEX #{table}_owner_idx ON #{table}(owner_id)")
        statements.push("CREATE INDEX #{table}_expiry_idx ON #{table}(expires_at)")
      end
      statements.push("CREATE TABLE account_tokens (#{id}, kind VARCHAR(32) NOT NULL, account_id #{ref} NOT NULL, " +
        "purpose VARCHAR(32) NOT NULL, token_digest VARCHAR(64) NOT NULL UNIQUE, expires_at BIGINT NOT NULL, created_at BIGINT NOT NULL)")
      statements.push("CREATE INDEX account_tokens_account_idx ON account_tokens(kind, account_id, purpose)")
      statements.push("CREATE INDEX account_tokens_expiry_idx ON account_tokens(expires_at)")
      statements.push("CREATE TABLE rate_limits (bucket VARCHAR(64) NOT NULL, window_start BIGINT NOT NULL, count INTEGER NOT NULL, " +
        "PRIMARY KEY (bucket, window_start))")
      statements.push("CREATE TABLE mail_outbox (#{id}, to_address VARCHAR(254) NOT NULL, subject TEXT NOT NULL, body TEXT NOT NULL, " +
        "attempts INTEGER NOT NULL DEFAULT 0, next_attempt_at BIGINT NOT NULL, created_at BIGINT NOT NULL)")
      statements.push("CREATE INDEX mail_outbox_due_idx ON mail_outbox(next_attempt_at)")
      statements
    end
  end
end
