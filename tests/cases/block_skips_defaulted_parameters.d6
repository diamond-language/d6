# A block, whether written as `do ... end` or forwarded with `&block`, binds
# the callee's &block parameter. Defaulted parameters before it keep their
# defaults, for functions, instance and singleton methods, and receivers whose
# type the compiler doesn't know.
class Walker
  def visit(x: Int, path: Array | Nil = nil, &emit)
    yield([x, path])
  end

  def forward(x: Int, &emit)
    visit(x, &emit)
    visit(x, ["given"], &emit)
    self.visit(x, &emit)
  end

  # The callee is defined below its caller, so the call has no signature
  # for it yet.
  def forward_later(x: Int, &emit)
    result = self.later(x, &emit)
    yield(["later returned", result])
  end

  def later(x: Int, path: Array | Nil = nil, &emit) -> String | Nil
    yield([x, path])
    nil
  end

  def self.walk(x: Int, depth: Int = 0, &emit)
    yield([x, depth])
  end

  def self.forward(x: Int, &emit)
    Walker.walk(x, &emit)
  end
end

def visit(x: Int, path: Array | Nil = nil, &emit)
  yield([x, path])
end

def forward(x: Int, &emit)
  visit(x, &emit)
end

# The receiver is a parameter: the call goes through a keyword trampoline that
# once inherited this function's own parameter checks and failed.
def typed_receiver(walker: Walker, &emit)
  walker.visit(1) do |pair| yield(["do", pair]) end
  walker.visit(2, &emit)
end

def untyped_receiver(table: Hash, &emit)
  table["walker"].visit(3) do |pair| yield(["untyped do", pair]) end
  table["walker"].visit(4, &emit)
  # A native method on a receiver of unknown type still gets the block.
  table["items"].each(&emit)
end

def show(value)
  puts(value.inspect())
end

forward(0) do |value| show(value) end
Walker.new().forward(1) do |value| show(value) end
Walker.forward(2) do |value| show(value) end
Walker.new().forward_later(5) do |value| show(value) end
typed_receiver(Walker.new()) do |value| show(value) end
untyped_receiver({"walker" => Walker.new(), "items" => [7, 8]}) do |value| show(value) end
