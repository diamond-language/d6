# Nesting is bounded like JSON.parse's: in a fiber, 150 levels encode, deeper
# (and any self-containing collection) raises JSONError instead of recursing
# until the C stack overflows. (The main program allows far more: tests/run.sh.)
def nest(levels)
  value = []
  levels.times() do |step|
    value = [value]
  end
  value
end

puts(JSON.stringify(nest(50)).length())
puts(JSON.stringify(nest(149)).length())

def attempt(label, &block)
  begin
    yield
    puts("#{label}: ok")
  rescue e
    puts("#{label}: #{e.class()}")
  end
end

def in_fiber(levels: Int) -> String
  def encode() = JSON.stringify(nest(levels))
  Fiber.new(encode).resume()
end

puts(in_fiber(149).length())
attempt("150 levels in a fiber") do
  in_fiber(150)
end
attempt("200 levels in a fiber") do
  in_fiber(200)
end

cyclic_array = []
cyclic_array.push(cyclic_array)
attempt("array containing itself") do
  JSON.stringify(cyclic_array)
end

cyclic_hash = {}
cyclic_hash["self"] = cyclic_hash
attempt("hash containing itself") do
  JSON.stringify(cyclic_hash)
end

# The failed attempts must leave the encoder usable.
puts(JSON.stringify([1, {"a": [2]}]))
