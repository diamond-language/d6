# String literals and heredocs longer than 4095 bytes (they used to stop
# compiling at 4096 with "string literal is too long").
plain = ""
quoted = ''
escaped = "é\x41"
heredoc = <<~TEXT
  
  end
TEXT
puts(plain.length())
puts(quoted.length())
puts(escaped.length())
puts(heredoc.length())
plain == quoted
