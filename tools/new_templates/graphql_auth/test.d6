# Run with `d6 test/{{name}}_test.d6`, or `bash test.sh` for every test file.
# The tests call the handler with request hashes, so no server starts. Each test
# gets an in-memory database and keeps the mail it would have sent.
require_cut "minitest"
require "../lib/{{name}}"

def run_tests()
  # A context like a worker's: a fresh database, and an outbox instead of mail.
  def fresh_context()
    sent = []
    def keep(row)
      sent.push(row)
      true
    end
    {"database": ":memory:", "mail_sender": keep, "sent": sent}
  end

  # POSTs a query and returns the decoded result.
  def query(context: Hash, text: String, variables: Hash = {}, token = nil)
    headers = if token == nil then {} else {"authorization": "Bearer #{token}"} end
    request = {"method": "POST", "path": "/graphql", "headers": headers, "peer_address": "203.0.113.5",
      "body": JSON.stringify({"query": text, "variables": variables})}
    [status, response_headers, body] = {{Name}}.call(request, context)
    JSON.parse(body)
  end

  def error_code(result) = result["errors"][0]["extensions"]["code"]

  def sign_up(context, email = "ada@example.com", password = "correct horse")
    result = query(context, "mutation($e: String!, $p: String!) { signUp(email: $e, name: \"Ada\", password: $p) { token user { email emailVerified } } }",
      {"e": email, "p": password})
    result["data"]["signUp"]
  end

  # The token in the newest message, after the tick has sent it.
  def mailed_token(context)
    {{Name}}.tick(context)
    body = context["sent"][-1]["body"]
    Regexp.new("\\): ([a-z_]+[0-9a-f]{64})").match(body)[1]
  end

  def test_sign_up_and_me()
    context = fresh_context()
    session = sign_up(context)
    Minitest.assert_equal({"email": "ada@example.com", "emailVerified": false}, session["user"])
    me = query(context, "{ me { name email } }", {}, session["token"])
    Minitest.assert_equal("Ada", me["data"]["me"]["name"])
    Minitest.assert_equal("UNAUTHENTICATED", error_code(query(context, "{ me { name } }")))
  end

  def test_duplicate_email_is_a_conflict()
    context = fresh_context()
    sign_up(context)
    result = query(context, "mutation { signUp(email: \"ADA@example.com\", name: \"Ada\", password: \"another one\") { token } }")
    Minitest.assert_equal("CONFLICT", error_code(result))
  end

  def test_sign_in_and_out()
    context = fresh_context()
    sign_up(context)
    wrong = query(context, "mutation { signIn(email: \"ada@example.com\", password: \"wrong guess\") { token } }")
    Minitest.assert_equal("UNAUTHENTICATED", error_code(wrong))
    signed_in = query(context, "mutation { signIn(email: \"ada@example.com\", password: \"correct horse\") { token } }")
    token = signed_in["data"]["signIn"]["token"]
    Minitest.assert(query(context, "mutation { signOut }", {}, token)["data"]["signOut"])
    Minitest.assert_equal("UNAUTHENTICATED", error_code(query(context, "{ me { name } }", {}, token)))
  end

  def test_notes_need_a_verified_email()
    context = fresh_context()
    token = sign_up(context)["token"]
    refused = query(context, "mutation { addNote(text: \"hello\") { id } }", {}, token)
    Minitest.assert_equal("FORBIDDEN", error_code(refused))
    verify = mailed_token(context)
    Minitest.assert(query(context, "mutation($t: String!) { verifyEmail(token: $t) }", {"t": verify})["data"]["verifyEmail"])
    added = query(context, "mutation { addNote(text: \"hello\") { text } }", {}, token)
    Minitest.assert_equal("hello", added["data"]["addNote"]["text"])
    listed = query(context, "{ notes { text } }", {}, token)
    Minitest.assert_equal([{"text": "hello"}], listed["data"]["notes"])
  end

  def test_password_reset_signs_out_everywhere()
    context = fresh_context()
    token = sign_up(context)["token"]
    {{Name}}.tick(context)
    asked = query(context, "mutation { requestPasswordReset(email: \"ada@example.com\") }")
    Minitest.assert(asked["data"]["requestPasswordReset"])
    reset = mailed_token(context)
    done = query(context, "mutation($t: String!) { resetPassword(token: $t, newPassword: \"new password\") }", {"t": reset})
    Minitest.assert(done["data"]["resetPassword"])
    Minitest.assert_equal("UNAUTHENTICATED", error_code(query(context, "{ me { name } }", {}, token)))
    again = query(context, "mutation { signIn(email: \"ada@example.com\", password: \"new password\") { token } }")
    Minitest.refute_nil(again["data"]["signIn"]["token"])
  end

  def test_unknown_email_reset_still_answers_true()
    context = fresh_context()
    result = query(context, "mutation { requestPasswordReset(email: \"nobody@example.com\") }")
    Minitest.assert(result["data"]["requestPasswordReset"])
    {{Name}}.tick(context)
    Minitest.assert_equal(0, context["sent"].length())
  end

  def test_delete_account()
    context = fresh_context()
    token = sign_up(context)["token"]
    wrong = query(context, "mutation { deleteAccount(password: \"wrong guess\") }", {}, token)
    Minitest.assert_equal("UNAUTHENTICATED", error_code(wrong))
    Minitest.assert(query(context, "mutation { deleteAccount(password: \"correct horse\") }", {}, token)["data"]["deleteAccount"])
    Minitest.assert_equal("UNAUTHENTICATED", error_code(query(context, "{ me { name } }", {}, token)))
  end

  suite = Minitest.new()
  suite.test("signUp creates an account and me returns it", test_sign_up_and_me)
  suite.test("a registered email is a CONFLICT", test_duplicate_email_is_a_conflict)
  suite.test("signIn checks the password and signOut ends the session", test_sign_in_and_out)
  suite.test("notes need a verified email", test_notes_need_a_verified_email)
  suite.test("a password reset signs out everywhere", test_password_reset_signs_out_everywhere)
  suite.test("a reset for an unknown email still answers true", test_unknown_email_reset_still_answers_true)
  suite.test("deleteAccount checks the password", test_delete_account)
  exit(suite.run() ? 0 : 1)
end
run_tests()
