# Starts the GraphQL server. PORT and HOST come from the environment; the
# default host 127.0.0.1 keeps the server private until it sits behind a
# reverse proxy or HOST says otherwise. DATABASE names the SQLite file.
require_cut "gremlin"
require "lib/{{name}}"

port = ENV["PORT"] == nil ? 8080 : ENV["PORT"].to_i()
host = ENV["HOST"] == nil ? "127.0.0.1" : ENV["HOST"]
puts("{{name}} serving GraphQL at http://#{host}:#{port}/graphql")
# The tick sends queued mail (reset and verification messages) about once a second.
gremlin_serve(port, {{Name}}.call, host: host, tick_interval: 1.0, on_tick: {{Name}}.tick)
