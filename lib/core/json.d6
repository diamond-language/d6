# Public JSON entry points. JSONCodec is defined by the compatibility core.
module JSON
  module_function

  # Native (diamond_json_stringify, src/vm.c) -- see json_codec.d6.
  # JSON.stringify(value) is compact. The optional second argument is a Hash of options:
  # "indent" (an Int number of spaces, or a String of whitespace) lays the document out over
  # several lines, and "sort_keys" (true) writes each Hash's keys in sorted order.
  def stringify(value, options = nil) -> String
    return diamond_json_stringify(value) if options == nil
    diamond_json_stringify(value, options)
  end
  # Native (String#parse_json, src/vm.c) -- see its own comment for why.
  def parse(source: String) = source.parse_json()

  # Calls the block with each value of a stream of JSON values separated by
  # whitespace (JSON Lines, or several documents in one file). Values before
  # invalid text reach the block before JSONError is raised.
  def each(source: String, &visit) -> Nil
    offset = 0
    loop do
      step = source.parse_json_at(offset)
      return nil if step == nil
      yield(step[0])
      offset = step[1]
    end
    nil
  end

  # Every value of such a stream, in an Array.
  def parse_all(source: String) -> Array
    values = []
    JSON.each(source) do |value| values.push(value) end
    values
  end
end
